# Local environment files - never commit real secrets/settings
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example

# Azure Developer CLI local state. Keep the checked-in deployment plan.
.azure/*
!.azure/.gitignore
!.azure/deployment-plan.md

# Generated Bicep validation and compiled templates
infra/validation-*.bicepparam
infra/main.json
infra/*.bicep.json

# Python environments, bytecode, and tool caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
build/
dist/
*.egg-info/
.coverage
.coverage.*
htmlcov/
coverage/
coverage.xml
junit.xml

# JavaScript dependencies and browser-test output
node_modules/
playwright-report/
test-results/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs and transient files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo

# IDE and operating-system metadata
.idea/
.DS_Store
Thumbs.db
Desktop.ini
